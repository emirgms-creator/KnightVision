{
  "manifest_version": 3,
  "name": "KnightVision - Chess AI HUD",
  "version": "1.0.0",
  "description": "Real-time chess board perception and Stockfish engine companion for study and bot training.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open KnightVision HUD"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/board_parser.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/engine/stockfish.js",
        "src/engine/stockfish.wasm.js",
        "src/engine/stockfish.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
